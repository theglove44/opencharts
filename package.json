{
  "name": "oss-charts",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"pnpm --filter @oss-charts/api dev\" \"pnpm --filter @oss-charts/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.0.0",
    "globals": "^16.0.0",
    "svelte-eslint-parser": "^1.0.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "devalue": "^5.8.1",
    "cookie": "^0.7.2",
    "rollup": "^4.62.0",
    "ajv": "^8.20.0",
    "minimatch": "^9.0.7",
    "brace-expansion": "^2.1.1",
    "picomatch": "^4.0.2",
    "flatted": "^3.4.2",
    "yaml": "^2.7.1",
    "lodash": "^4.17.21",
    "fast-uri": "^3.1.2",
    "shell-quote": "^1.8.4",
    "js-yaml": "^4.2.0",
    "postcss": "^8.5.10",
    "esbuild": "^0.28.1"
  }
}
