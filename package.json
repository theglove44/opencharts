{
  "name": "oss-charts",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"pnpm --filter @oss-charts/api dev\" \"pnpm --filter @oss-charts/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.20.0",
      "brace-expansion@<1.1.13": "1.1.13",
      "cookie": "^0.7.0",
      "fast-uri": "^3.1.2",
      "flatted": "^3.4.2",
      "postcss": "^8.5.15",
      "rollup": "^4.61.1",
      "yaml@>=1.0.0 <1.10.3": "1.10.3"
    }
  }
}
